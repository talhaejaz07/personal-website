---
interface Post {
  title: string;
  description: string;
  pubDate: string;
  category: string;
  cardImage: string;
  cardImageAlt: string;
}

interface Props {
  post: Post;
  href: string;
}

const { post, href } = Astro.props;
const date = new Date(`${post.pubDate}T00:00:00`).toLocaleDateString('en-PK', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class="post-card">
  <a class="post-card__image" href={href} aria-label={`Read: ${post.title}`}>
    <img src={post.cardImage} alt={post.cardImageAlt} width="900" height="900" loading="lazy" decoding="async" />
    <span class="post-card__category">{post.category}</span>
  </a>
  <div class="post-card__body">
    <time class="post-card__date" datetime={post.pubDate}>{date}</time>
    <h3><a href={href}>{post.title}</a></h3>
    <p>{post.description}</p>
    <a class="post-card__read" href={href}>READ ARTICLE <span aria-hidden="true">↗</span></a>
  </div>
</article>

<style>
  .post-card { display: flex; min-width: 0; flex-direction: column; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .post-card__image { display: block; min-width: 0; }
  .post-card__image img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; background: var(--dark-surface); transition: opacity .2s ease; }
  .post-card__image:hover img { opacity: .88; }
  .post-card__category { display: block; margin-top: 23px; color: var(--deep-red); font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .06em; line-height: 1.5; }
  .post-card__body { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding-top: 10px; }
  .post-card__date { color: var(--muted); font-family: var(--mono); font-size: 11px; letter-spacing: .01em; line-height: 1.5; }
  .post-card h3 { margin: 15px 0 16px; color: var(--ink); font-family: var(--display); font-size: clamp(30px, 2.5vw, 35px); font-weight: 600; letter-spacing: -.012em; line-height: 1.12; text-wrap: pretty; }
  .post-card h3 a { transition: color .2s ease; }
  .post-card h3 a:hover { color: var(--deep-red); }
  .post-card p { margin: 0 0 22px; color: var(--muted); font-size: 15px; line-height: 1.7; }
  .post-card__read { display: inline-flex; min-height: 44px; align-items: center; gap: 12px; margin-top: auto; color: var(--deep-red); font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .055em; }
  .post-card__read span { font-size: 17px; transition: transform .2s ease; }
  .post-card__read:hover span { transform: translate(2px, -2px); }
  a:focus-visible { outline: 2px solid var(--deep-red); outline-offset: 5px; }
  @media (max-width: 600px) {
    .post-card { padding-bottom: 14px; }
    .post-card__category { margin-top: 20px; }
    .post-card h3 { font-size: 32px; }
    .post-card p { font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) { .post-card__image img, .post-card h3 a, .post-card__read span { transition: none; } }
</style>
