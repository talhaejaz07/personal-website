---
interface Post {
  title: string;
  description: string;
  pubDate: string;
  category: string;
  cardImage: string;
  cardImageAlt: string;
}

interface Props {
  post: Post;
  href: string;
}

const { post, href } = Astro.props;
const date = new Date(`${post.pubDate}T00:00:00`).toLocaleDateString('en-PK', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class="post-card">
  <a class="post-card__image" href={href} aria-label={`Read: ${post.title}`}>
    <img src={post.cardImage} alt={post.cardImageAlt} width="900" height="900" loading="lazy" decoding="async" />
    <span class="post-card__category">{post.category}</span>
  </a>
  <div class="post-card__body">
    <time class="post-card__date" datetime={post.pubDate}>{date}</time>
    <h3><a href={href}>{post.title}</a></h3>
    <p>{post.description}</p>
    <a class="post-card__read" href={href}>READ ARTICLE <span aria-hidden="true">↗</span></a>
  </div>
</article>

<style>
  .post-card { min-width: 0; overflow: hidden; background: #fff; box-shadow: 0 14px 40px rgb(35 35 38 / 6%); }
  .post-card__image { position: relative; display: block; aspect-ratio: 1; overflow: hidden; background: #343338; }
  .post-card__image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .post-card__image:hover img { transform: scale(1.035); }
  .post-card__category { position: absolute; right: 12px; bottom: 12px; padding: 8px 10px; background: #232326; color: #f5f2ef; font-family: "DM Mono", monospace; font-size: 9px; letter-spacing: .12em; }
  .post-card__body { padding: 23px 24px 25px; }
  .post-card__date { color: #716c6b; font-family: "DM Mono", monospace; font-size: 10px; letter-spacing: .06em; }
  .post-card h3 { margin: 12px 0 10px; color: #262427; font-family: "Barlow Condensed", "Arial Narrow", sans-serif; font-size: clamp(27px, 3vw, 35px); font-weight: 700; line-height: .99; }
  .post-card h3 a:hover { color: #a85443; }
  .post-card p { margin: 0; color: #716c6b; font-size: 13px; line-height: 1.7; }
  .post-card__read { display: inline-flex; align-items: center; gap: 9px; margin-top: 20px; color: #a85443; font-family: "DM Mono", monospace; font-size: 9px; font-weight: 500; letter-spacing: .1em; }
  .post-card__read span { font-size: 13px; }
  a:focus-visible { outline: 3px solid #a85443; outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .post-card__image img { transition: none; } }
</style>
