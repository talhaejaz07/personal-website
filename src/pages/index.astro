---
const xUrl = 'https://x.com/TalhaEjaz07ee';
const youtubeUrl = 'https://www.youtube.com/@TalhaEjaz';
const currentYear = new Date().getFullYear();
import BlogCard from '../components/BlogCard.astro';

interface BlogFrontmatter {
  title: string;
  description: string;
  pubDate: string;
  category: string;
  cardImage: string;
  cardImageAlt: string;
}

interface MarkdownPage {
  frontmatter: BlogFrontmatter;
  url?: string;
}

const blogPosts = Object.entries(import.meta.glob<MarkdownPage>('./blog/*.md', { eager: true }))
  .map(([path, post]) => ({
    ...post.frontmatter,
    href: post.url ? (post.url.endsWith('/') ? post.url : `${post.url}/`) : `/blog/${path.split('/').at(-1)?.replace(/\.md$/, '')}/`,
  }))
  .sort((a, b) => Date.parse(b.pubDate) - Date.parse(a.pubDate));
const latestPosts = blogPosts.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#232326" />
    <meta
      name="description"
      content="Talha Ejaz writes and shares videos about PSX investing, technology, and a greener future."
    />
    <meta property="og:title" content="Talha Ejaz — Investing with perspective" />
    <meta
      property="og:description"
      content="Personal notes on PSX investing, technology, and the ideas shaping a greener future."
    />
    <meta property="og:type" content="website" />
    <title>Talha Ejaz — Investing with perspective</title>
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero__geometry" aria-hidden="true"></div>
        <header class="site-header wrap">
          <a class="wordmark" href="#top" aria-label="Talha Ejaz home">
            <span class="wordmark__name">TALHA EJAZ</span>
            <span class="wordmark__sub">MARKETS &amp; IDEAS</span>
          </a>

          <nav class="main-nav" aria-label="Main navigation">
            <a href="#focus">FOCUS</a>
            <a href="#channels">CHANNELS</a>
            <a href="#about">ABOUT</a>
            <a href="/blog/">BLOG</a>
          </nav>

          <a class="header-link" href={xUrl} target="_blank" rel="me noreferrer">
            FOLLOW ON X <span aria-hidden="true">↗</span>
          </a>
        </header>

        <div class="hero__inner wrap">
          <div class="hero__copy">
            <p class="eyebrow"><span class="eyebrow__dot"></span> PSX · INVESTING · WHAT'S NEXT</p>
            <h1 id="hero-title">Investing,<br /><span>with perspective.</span></h1>
            <p class="hero__intro">
              Notes on the Pakistan stock market, the businesses behind the numbers,
              and the technology shaping a greener future.
            </p>
            <div class="hero__actions">
              <a class="button button--coral" href={xUrl} target="_blank" rel="me noreferrer">
                Follow my market notes <span aria-hidden="true">↗</span>
              </a>
              <a class="text-link text-link--light" href={youtubeUrl} target="_blank" rel="me noreferrer">
                Watch on YouTube <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="hero__portrait">
            <img
              src="/images/talha-ejaz-hero.webp"
              alt="Portrait of Talha Ejaz"
              width="1092"
              height="1440"
              fetchpriority="high"
              decoding="async"
            />
          </div>

          <div class="hero__aside" aria-hidden="true">
            <span>LONG-TERM THINKING</span>
            <span class="hero__aside-rule"></span>
            <span>INDEPENDENT CURIOSITY</span>
          </div>
        </div>

        <div class="hero__base wrap">
          <span>PERSONAL NOTES · PUBLIC IDEAS</span>
          <span class="hero__base-line"></span>
          <a href="#focus">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <section class="focus section-light" id="focus" aria-labelledby="focus-title">
        <div class="focus__mark" aria-hidden="true">TE</div>
        <div class="wrap focus__inner">
          <p class="eyebrow eyebrow--coral">WHAT I FOLLOW</p>
          <h2 id="focus-title">Curious about the<br /><span>forces behind change.</span></h2>
          <p class="focus__lead">
            My main focus is investing in PSX-listed companies. I also follow the
            technologies and ideas changing how we live and produce energy.
          </p>

          <div class="focus-grid">
            <article class="focus-card focus-card--market">
              <div class="focus-card__top"><span>01 / THE MAIN FOCUS</span><span aria-hidden="true">↗</span></div>
              <div class="focus-card__icon focus-card__icon--chart" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                  <path d="M7 37.5h34M10 32l9-9 7 5 12-15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M30 13h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <h3>PSX investing</h3>
              <p>Company research, market observations, and a long-term view of investing.</p>
              <a class="text-link" href={xUrl} target="_blank" rel="me noreferrer">
                Read my posts on X <span aria-hidden="true">↗</span>
              </a>
            </article>

            <article class="focus-card focus-card--energy">
              <div class="focus-card__top"><span>02 / A CHANGING WORLD</span><span aria-hidden="true">↗</span></div>
              <div class="focus-card__icon focus-card__icon--sun" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                  <circle cx="24" cy="24" r="7" stroke="currentColor" stroke-width="2" />
                  <path d="M24 5v5m0 28v5M5 24h5m28 0h5M10.6 10.6l3.6 3.6m19.6 19.6 3.6 3.6m0-26.8-3.6 3.6m-19.6 19.6-3.6 3.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </div>
              <h3>Tech &amp; green energy</h3>
              <p>Solar, batteries, and the technologies that could shape a cleaner future.</p>
              <a class="text-link" href="#about">A little more about me <span aria-hidden="true">↓</span></a>
            </article>

            <article class="focus-card focus-card--thoughts">
              <div class="focus-card__top"><span>03 / NOTES ALONG THE WAY</span><span aria-hidden="true">↗</span></div>
              <div class="focus-card__icon focus-card__icon--spark" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                  <path d="m24 5 3.5 13.5L41 22l-13.5 3.5L24 39l-3.5-13.5L7 22l13.5-3.5L24 5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                </svg>
              </div>
              <h3>Thoughts in progress</h3>
              <p>Occasional notes, questions, and ideas that don't fit neatly in a chart.</p>
              <a class="text-link" href={xUrl} target="_blank" rel="me noreferrer">
                Find me on X <span aria-hidden="true">↗</span>
              </a>
            </article>
          </div>
        </div>
      </section>

      <section class="channels" id="channels" aria-labelledby="channels-title">
        <div class="channels__pattern" aria-hidden="true"></div>
        <div class="wrap channels__inner">
          <div class="channels__copy">
            <p class="eyebrow"><span class="eyebrow__dot"></span> KEEP THE CONVERSATION GOING</p>
            <h2 id="channels-title">Different formats.<br /><span>Same curiosity.</span></h2>
            <p>
              I share regular investing posts on X, make videos for YouTube, and
              use X for the other ideas on my mind too.
            </p>
            <div class="channels__links">
              <a class="button button--coral" href={youtubeUrl} target="_blank" rel="me noreferrer">
                Visit my YouTube channel <span aria-hidden="true">↗</span>
              </a>
              <a class="text-link text-link--light" href={xUrl} target="_blank" rel="me noreferrer">
                Follow on X <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <a class="video-card" href={youtubeUrl} target="_blank" rel="me noreferrer" aria-label="Visit Talha Ejaz on YouTube">
            <span class="video-card__grid" aria-hidden="true"></span>
            <span class="video-card__label">ON YOUTUBE</span>
            <span class="video-card__orb" aria-hidden="true"></span>
            <span class="video-card__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.8c0-.77.84-1.25 1.5-.86l10.1 6.2a1 1 0 0 1 0 1.72l-10.1 6.2A1 1 0 0 1 8 18.2V5.8Z" /></svg>
            </span>
            <span class="video-card__caption"><span>MARKETS · IDEAS · EXPLAINED</span><strong>Watch the videos</strong></span>
            <span class="video-card__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="latest-blog section-light" id="blog" aria-labelledby="blog-title">
        <div class="wrap">
          <div class="latest-blog__heading">
            <div>
              <p class="eyebrow eyebrow--coral">FROM THE BLOG</p>
              <h2 id="blog-title">Notes worth<br /><span>thinking through.</span></h2>
            </div>
            <a class="text-link" href="/blog/">All articles <span aria-hidden="true">↗</span></a>
          </div>
          <div class="latest-blog__grid">
            {latestPosts.map((post) => <BlogCard post={post} href={post.href} />)}
          </div>
        </div>
      </section>

      <section class="about section-light" id="about" aria-labelledby="about-title">
        <div class="wrap about__inner">
          <div class="about__number" aria-hidden="true">T<span>E</span></div>
          <div class="about__copy">
            <p class="eyebrow eyebrow--coral">A LITTLE ABOUT ME</p>
            <h2 id="about-title">Look closer.<br /><span>Think longer.</span></h2>
            <p>
              I’m Talha Ejaz. I enjoy understanding how systems work, asking what
              sits behind the headlines, and sharing what I learn along the way.
              This is my space for market notes, videos, and the ideas I keep coming back to.
            </p>
            <a class="text-link" href={xUrl} target="_blank" rel="me noreferrer">
              More thoughts on X <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="about__signature" aria-hidden="true">TALHA<br />EJAZ<span>.</span></div>
        </div>
      </section>

      <footer class="site-footer" id="socials">
        <div class="wrap footer__inner">
          <div class="footer__intro">
            <p class="eyebrow"><span class="eyebrow__dot"></span> SOCIAL</p>
            <h2>Follow along.</h2>
            <p>Market notes on X. Videos on YouTube. More ideas in between.</p>
          </div>
          <div class="footer__links">
            <a href={xUrl} target="_blank" rel="me noreferrer">
              <span class="social-icon" aria-hidden="true">𝕏</span><span>X / TALHAEJAZ07EE</span><span aria-hidden="true">↗</span>
            </a>
            <a href={youtubeUrl} target="_blank" rel="me noreferrer">
              <span class="social-icon social-icon--play" aria-hidden="true">▶</span><span>YOUTUBE / TALHAEJAZ</span><span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="wrap footer__base">
          <a class="wordmark wordmark--footer" href="#top">
            <span class="wordmark__name">TALHA EJAZ</span>
            <span class="wordmark__sub">MARKETS &amp; IDEAS</span>
          </a>
          <span>© {currentYear} TALHA EJAZ</span>
          <a href="#top">BACK TO TOP ↑</a>
        </div>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --graphite: #232326;
    --charcoal: #343338;
    --ivory: #f5f2ef;
    --paper: #fff;
    --coral: #e5a18f;
    --coral-deep: #a85443;
    --ink: #262427;
    --muted: #716c6b;
    --green: #2f7657;
    --red: #a64545;
    --display: "Barlow Condensed", "Arial Narrow", sans-serif;
    --body: "DM Sans", Arial, sans-serif;
    --mono: "DM Mono", monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 1rem; }
  body { margin: 0; background: var(--ivory); color: var(--ink); font-family: var(--body); -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 3px solid var(--coral); outline-offset: 5px; }
  ::selection { background: var(--coral); color: var(--graphite); }
  .wrap { width: min(1200px, calc(100% - 64px)); margin-inline: auto; }
  .skip-link { position: fixed; z-index: 30; top: 12px; left: 12px; padding: 12px 16px; background: var(--paper); color: var(--ink); transform: translateY(-150%); }
  .skip-link:focus { transform: translateY(0); }

  .hero { position: relative; min-height: 760px; overflow: hidden; background: var(--graphite); color: var(--ivory); isolation: isolate; }
  .hero__geometry { position: absolute; z-index: -1; inset: 0; overflow: hidden; pointer-events: none; }
  .hero__geometry::before { position: absolute; top: 95px; left: -145px; width: 410px; height: 590px; border: 42px solid rgb(229 161 143 / 11%); content: ""; transform: skewY(-35deg) rotate(35deg); }
  .hero__geometry::after { position: absolute; right: 4%; bottom: -180px; width: 460px; height: 680px; border: 2px solid rgb(229 161 143 / 14%); content: ""; transform: rotate(42deg); }
  .site-header { position: relative; z-index: 5; display: flex; align-items: center; justify-content: space-between; min-height: 98px; border-bottom: 1px solid rgb(255 255 255 / 12%); }
  .wordmark { display: flex; flex-direction: column; gap: 3px; width: max-content; }
  .wordmark__name { font-family: var(--display); font-size: 28px; font-weight: 700; letter-spacing: .025em; line-height: .9; }
  .wordmark__sub { color: var(--coral); font-family: var(--mono); font-size: 8px; letter-spacing: .2em; }
  .main-nav { display: flex; align-items: center; gap: clamp(20px, 4vw, 54px); }
  .main-nav a, .header-link { color: rgb(245 242 239 / 72%); font-size: 10px; font-weight: 600; letter-spacing: .11em; transition: color .2s ease; }
  .main-nav a:hover, .header-link:hover { color: var(--coral); }
  .header-link { color: var(--coral); }
  .header-link span { margin-left: 5px; }
  .hero__inner { position: relative; display: flex; min-height: 600px; align-items: center; }
  .hero__copy { position: relative; z-index: 2; width: min(650px, 63%); padding: 20px 0 68px; }
  .eyebrow { display: flex; align-items: center; gap: 11px; margin: 0 0 22px; color: var(--coral); font-size: 10px; font-weight: 700; letter-spacing: .17em; }
  .eyebrow__dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 4px rgb(229 161 143 / 13%); }
  .hero h1, .channels h2, .about h2, .focus h2 { margin: 0; font-family: var(--display); font-weight: 700; letter-spacing: -.015em; text-transform: uppercase; }
  .hero h1 { max-width: 680px; font-size: clamp(76px, 9.4vw, 132px); line-height: .79; }
  .hero h1 span, .channels h2 span, .about h2 span { color: var(--coral); }
  .hero__intro { max-width: 440px; margin: 30px 0 0; color: rgb(245 242 239 / 77%); font-size: 16px; line-height: 1.7; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 25px; margin-top: 30px; }
  .button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 13px; padding: 0 20px; font-size: 11px; font-weight: 700; transition: transform .2s ease, background .2s ease; }
  .button:hover { transform: translateY(-2px); }
  .button--coral { background: var(--coral); color: var(--graphite); }
  .button--coral:hover { background: #efb09f; }
  .text-link { display: inline-flex; align-items: center; gap: 10px; color: var(--coral-deep); font-size: 12px; font-weight: 700; }
  .text-link span { transition: transform .2s ease; }
  .text-link:hover span { transform: translate(2px, -2px); }
  .text-link--light { color: var(--ivory); }
  .hero__portrait { position: absolute; z-index: 1; right: -4.2%; bottom: 0; width: min(62%, 740px); height: 100%; display: flex; justify-content: center; align-items: end; }
  .hero__portrait::after { position: absolute; inset: 0; background: linear-gradient(90deg, var(--graphite) 0%, rgb(35 35 38 / 80%) 4%, transparent 33%), linear-gradient(0deg, var(--graphite) 0%, transparent 18%); content: ""; pointer-events: none; }
  .hero__portrait img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }
  .hero__aside { position: absolute; z-index: 2; right: 0; top: 41%; display: flex; align-items: center; gap: 10px; color: rgb(245 242 239 / 45%); font-family: var(--mono); font-size: 8px; letter-spacing: .13em; writing-mode: vertical-rl; }
  .hero__aside-rule { display: block; width: 1px; height: 42px; background: var(--coral); }
  .hero__base { position: relative; z-index: 3; display: flex; align-items: center; gap: 18px; min-height: 62px; color: rgb(245 242 239 / 51%); font-family: var(--mono); font-size: 8px; letter-spacing: .14em; }
  .hero__base-line { width: min(180px, 20vw); height: 1px; background: rgb(245 242 239 / 23%); }
  .hero__base a { margin-left: auto; color: var(--coral); }

  .section-light { position: relative; overflow: hidden; background: var(--ivory); }
  .focus { padding: 110px 0 120px; }
  .focus__mark { position: absolute; top: 10px; left: -50px; color: rgb(229 161 143 / 10%); font-family: var(--display); font-size: 480px; font-weight: 700; letter-spacing: -.1em; line-height: 1; pointer-events: none; }
  .focus__inner { position: relative; z-index: 1; }
  .eyebrow--coral { color: var(--coral-deep); }
  .focus h2, .about h2 { color: var(--ink); font-size: clamp(56px, 7vw, 88px); line-height: .85; }
  .focus h2 span, .about h2 span { color: var(--coral-deep); }
  .focus__lead { max-width: 520px; margin: 24px 0 0; color: var(--muted); font-size: 15px; line-height: 1.7; }
  .focus-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 58px; }
  .focus-card { min-height: 290px; padding: 26px; background: var(--paper); box-shadow: 0 14px 40px rgb(35 35 38 / 5%); }
  .focus-card--market { border-top: 3px solid var(--coral-deep); }
  .focus-card--energy { border-top: 3px solid #5c7865; }
  .focus-card--thoughts { border-top: 3px solid #77737b; }
  .focus-card__top { display: flex; justify-content: space-between; color: #8b8583; font-family: var(--mono); font-size: 8px; letter-spacing: .08em; }
  .focus-card__top span:last-child { color: var(--coral-deep); font-size: 12px; }
  .focus-card__icon { display: grid; width: 46px; height: 46px; place-items: center; margin-top: 29px; background: var(--ivory); }
  .focus-card__icon svg { width: 29px; height: 29px; }
  .focus-card__icon--chart { color: var(--coral-deep); }
  .focus-card__icon--sun { color: var(--green); }
  .focus-card__icon--spark { color: var(--charcoal); }
  .focus-card h3 { margin: 19px 0 7px; font-family: var(--display); font-size: 31px; font-weight: 700; line-height: 1; text-transform: uppercase; }
  .focus-card p { min-height: 46px; margin: 0 0 20px; color: var(--muted); font-size: 12px; line-height: 1.65; }

  .channels { position: relative; overflow: hidden; padding: 106px 0; background: var(--graphite); color: var(--ivory); }
  .channels__pattern { position: absolute; right: -120px; top: -230px; width: 490px; height: 720px; border: 2px solid rgb(229 161 143 / 14%); transform: rotate(37deg); pointer-events: none; }
  .channels__inner { position: relative; display: grid; grid-template-columns: 1fr .92fr; align-items: center; gap: 70px; }
  .channels h2, .about h2 { font-size: clamp(62px, 7vw, 92px); line-height: .83; }
  .channels__copy > p:not(.eyebrow) { max-width: 470px; margin: 24px 0 0; color: rgb(245 242 239 / 68%); font-size: 14px; line-height: 1.8; }
  .channels__links { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 28px; }
  .video-card { position: relative; display: flex; min-height: 345px; overflow: hidden; flex-direction: column; justify-content: space-between; padding: 24px; background: radial-gradient(ellipse at 64% 44%, rgb(229 161 143 / 34%), transparent 27%), linear-gradient(145deg, #45434a, #28272c 60%, #1c1c1f); box-shadow: 0 22px 55px rgb(0 0 0 / 24%); }
  .video-card::before { position: absolute; top: 50%; left: 50%; width: 250px; height: 250px; border: 1px solid rgb(245 242 239 / 18%); border-radius: 50%; content: ""; transform: translate(-50%, -55%); }
  .video-card::after { position: absolute; top: 50%; left: 50%; width: 170px; height: 170px; border: 1px solid rgb(229 161 143 / 36%); border-radius: 50%; content: ""; transform: translate(-50%, -55%); }
  .video-card__grid { position: absolute; inset: 0; background-image: linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px); background-size: 34px 34px; mask-image: linear-gradient(transparent, black); }
  .video-card__label, .video-card__caption, .video-card__arrow, .video-card__play { position: relative; z-index: 1; }
  .video-card__label { color: var(--coral); font-family: var(--mono); font-size: 9px; letter-spacing: .16em; }
  .video-card__orb { position: absolute; top: 50%; left: 50%; width: 110px; height: 110px; border: 1px solid rgb(229 161 143 / 42%); border-radius: 50%; background: rgb(229 161 143 / 10%); transform: translate(-50%, -58%); }
  .video-card__play { position: absolute; top: 50%; left: 50%; display: grid; width: 55px; height: 55px; place-items: center; border-radius: 50%; background: var(--coral); color: var(--graphite); transform: translate(-50%, -58%); transition: scale .2s ease; }
  .video-card__play svg { width: 20px; height: 20px; margin-left: 3px; }
  .video-card:hover .video-card__play { scale: 1.08; }
  .video-card__caption { display: flex; flex-direction: column; gap: 5px; }
  .video-card__caption span { color: rgb(245 242 239 / 62%); font-family: var(--mono); font-size: 8px; letter-spacing: .13em; }
  .video-card__caption strong { font-family: var(--display); font-size: 32px; line-height: 1; text-transform: uppercase; }
  .video-card__arrow { position: absolute; right: 24px; bottom: 25px; color: var(--coral); }

  .latest-blog { padding: 104px 0 112px; }
  .latest-blog__heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; }
  .latest-blog__heading .eyebrow { margin-bottom: 18px; }
  .latest-blog h2 { margin: 0; color: var(--ink); font-family: var(--display); font-size: clamp(58px, 7vw, 86px); font-weight: 700; line-height: .85; text-transform: uppercase; }
