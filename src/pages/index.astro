---
import '../styles/global.css';
import '../styles/home.css';
const xUrl = 'https://x.com/TalhaEjaz07ee';
const youtubeUrl = 'https://www.youtube.com/@TalhaEjaz';
const currentYear = new Date().getFullYear();
import BlogCard from '../components/BlogCard.astro';

interface BlogFrontmatter {
  title: string;
  description: string;
  pubDate: string;
  category: string;
  cardImage: string;
  cardImageAlt: string;
}

interface MarkdownPage {
  frontmatter: BlogFrontmatter;
  url?: string;
}

const blogPosts = Object.entries(import.meta.glob<MarkdownPage>('./blog/*.md', { eager: true }))
  .map(([path, post]) => ({
    ...post.frontmatter,
    href: post.url ? (post.url.endsWith('/') ? post.url : `${post.url}/`) : `/blog/${path.split('/').at(-1)?.replace(/\.md$/, '')}/`,
  }))
  .sort((a, b) => Date.parse(b.pubDate) - Date.parse(a.pubDate));
const latestPosts = blogPosts.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#100f0f" />
    <meta
      name="description"
      content="Talha Ejaz writes about PSX investing and wants to explore technology, engineering, and green energy in future writing and possibly videos."
    />
    <meta property="og:title" content="Talha Ejaz — Investing, technology &amp; energy" />
    <meta
      property="og:description"
      content="PSX investing is a major focus; future topics may include technology, engineering, and green energy."
    />
    <meta property="og:type" content="website" />
    <title>Talha Ejaz — Investing, technology &amp; energy</title>
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="preload" href="/fonts/barlow-condensed-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin-400-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="home-page">
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero__geometry" aria-hidden="true"></div>
        <header class="site-header wrap">
          <a class="wordmark" href="#top" aria-label="Talha Ejaz home">
            <span class="wordmark__name">TALHA EJAZ</span>
            <span class="wordmark__sub">MARKETS &amp; IDEAS</span>
          </a>

          <nav class="main-nav" aria-label="Main navigation">
            <a href="#focus">FOCUS</a>
            <a href="#channels">CHANNELS</a>
            <a href="#about">ABOUT</a>
            <a href="/blog/">BLOG</a>
          </nav>

          <a class="header-link" href={xUrl} target="_blank" rel="me noreferrer">
            FOLLOW ON X <span aria-hidden="true">↗</span>
          </a>
        </header>

        <div class="hero__inner wrap">
          <div class="hero__copy">
            <p class="eyebrow"><span class="eyebrow__dot"></span> PSX · TECHNOLOGY · ENGINEERING · GREEN ENERGY</p>
            <h1 id="hero-title">Investing,<br /><span>tech &amp; engineering.</span></h1>
            <p class="hero__intro">
              PSX investing is a major focus. I also want to explore technology,
              engineering, and green energy through future writing and, possibly, videos.
            </p>
            <div class="hero__actions">
              <a class="button button--accent-red" href={xUrl} target="_blank" rel="me noreferrer">
                Follow my market notes <span aria-hidden="true">↗</span>
              </a>
              <a class="text-link text-link--light" href={youtubeUrl} target="_blank" rel="me noreferrer">
                Watch on YouTube <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="hero__portrait">
            <img
              src="/images/talha-ejaz-hero.webp"
              alt="Portrait of Talha Ejaz"
              width="1092"
              height="1440"
              fetchpriority="high"
              decoding="async"
            />
          </div>

          <div class="hero__aside" aria-hidden="true">
            <span>COMPANY RESEARCH</span>
            <span class="hero__aside-rule"></span>
            <span>MARKET NOTES</span>
          </div>
        </div>

        <div class="hero__base wrap">
          <span>PSX NOTES · TECHNOLOGY · ENERGY</span>
          <span class="hero__base-line"></span>
          <a href="#focus">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <section class="focus section-light" id="focus" aria-labelledby="focus-title">
        <div class="focus__mark" aria-hidden="true">TE</div>
        <div class="wrap focus__inner">
          <p class="eyebrow eyebrow--accent-red">WHAT I FOLLOW</p>
          <h2 id="focus-title">Markets,<br /><span>technology &amp; energy.</span></h2>
          <p class="focus__lead">
            PSX investing is a major focus. I’m also interested in technology and
            engineering, especially where they connect with green energy.
          </p>

          <div class="focus-grid">
            <article class="focus-card focus-card--market">
              <div class="focus-card__top"><span>01 / THE MAIN FOCUS</span><span aria-hidden="true">↗</span></div>
              <div class="focus-card__icon focus-card__icon--chart" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                  <path d="M7 37.5h34M10 32l9-9 7 5 12-15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M30 13h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <h3>PSX investing</h3>
              <p>Company research, market observations, and a long-term view of investing.</p>
              <a class="text-link" href={xUrl} target="_blank" rel="me noreferrer">
                Read my posts on X <span aria-hidden="true">↗</span>
              </a>
            </article>

            <article class="focus-card focus-card--energy">
              <div class="focus-card__top"><span>02 / TECHNOLOGY &amp; GREEN ENERGY</span><span aria-hidden="true">↗</span></div>
              <div class="focus-card__icon focus-card__icon--sun" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                  <circle cx="24" cy="24" r="7" stroke="currentColor" stroke-width="2" />
                  <path d="M24 5v5m0 28v5M5 24h5m28 0h5M10.6 10.6l3.6 3.6m19.6 19.6 3.6 3.6m0-26.8-3.6 3.6m-19.6 19.6-3.6 3.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </div>
              <h3>Technology &amp; engineering</h3>
              <p>I’m interested in solar, batteries, and the engineering behind energy systems.</p>
              <a class="text-link" href="#about">A little more about me <span aria-hidden="true">↓</span></a>
            </article>

            <article class="focus-card focus-card--thoughts">
              <div class="focus-card__top"><span>03 / PERSONAL NOTES</span><span aria-hidden="true">↗</span></div>
              <div class="focus-card__icon focus-card__icon--spark" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                  <path d="m24 5 3.5 13.5L41 22l-13.5 3.5L24 39l-3.5-13.5L7 22l13.5-3.5L24 5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                </svg>
              </div>
              <h3>Personal notes</h3>
              <p>Personal thoughts and questions on topics beyond investing.</p>
              <a class="text-link" href={xUrl} target="_blank" rel="me noreferrer">
                Find me on X <span aria-hidden="true">↗</span>
              </a>
            </article>
          </div>
        </div>
      </section>

      <section class="channels" id="channels" aria-labelledby="channels-title">
        <div class="channels__pattern" aria-hidden="true"></div>
        <div class="wrap channels__inner">
          <div class="channels__copy">
            <p class="eyebrow"><span class="eyebrow__dot"></span> MY SOCIAL CHANNELS</p>
            <h2 id="channels-title">Writing on X.<br /><span>Videos on YouTube.</span></h2>
            <p>
              X is where I share investing posts and personal thoughts. I also want
              to write about technology, engineering, and green energy, and may make
              videos on those subjects.
            </p>
            <div class="channels__links">
              <a class="button button--accent-red" href={youtubeUrl} target="_blank" rel="me noreferrer">
                Visit my YouTube channel <span aria-hidden="true">↗</span>
              </a>
              <a class="text-link text-link--light" href={xUrl} target="_blank" rel="me noreferrer">
                Follow on X <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <a class="video-card" href={youtubeUrl} target="_blank" rel="me noreferrer" aria-label="Visit Talha Ejaz on YouTube">
            <span class="video-card__grid" aria-hidden="true"></span>
            <span class="video-card__label">ON YOUTUBE</span>
            <span class="video-card__orb" aria-hidden="true"></span>
            <span class="video-card__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.8c0-.77.84-1.25 1.5-.86l10.1 6.2a1 1 0 0 1 0 1.72l-10.1 6.2A1 1 0 0 1 8 18.2V5.8Z" /></svg>
            </span>
            <span class="video-card__caption"><span>INVESTING · TECH · ENGINEERING</span><strong>Watch the videos</strong></span>
            <span class="video-card__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="latest-blog section-light" id="blog" aria-labelledby="blog-title">
        <div class="wrap">
          <div class="latest-blog__heading">
            <div>
              <p class="eyebrow eyebrow--accent-red">FROM THE BLOG</p>
              <h2 id="blog-title">Latest<br /><span>writing.</span></h2>
            </div>
            <a class="text-link" href="/blog/">All articles <span aria-hidden="true">↗</span></a>
          </div>
          <div class="latest-blog__grid">
            {latestPosts.map((post) => <BlogCard post={post} href={post.href} />)}
          </div>
        </div>
      </section>

      <section class="about section-light" id="about" aria-labelledby="about-title">
        <div class="wrap about__inner">
          <div class="about__number" aria-hidden="true">T<span>E</span></div>
          <div class="about__copy">
            <p class="eyebrow eyebrow--accent-red">ABOUT ME</p>
            <h2 id="about-title">What I write<br /><span>and think about.</span></h2>
            <p>
              I’m Talha Ejaz. PSX investing is a major part of what I share. I’m also
              interested in technology, engineering, and green energy, including solar
              and batteries. I want to write about these and other interests, and may
              make videos on those subjects too.
            </p>
            <a class="text-link" href={xUrl} target="_blank" rel="me noreferrer">
              More thoughts on X <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="about__signature" aria-hidden="true">TALHA<br />EJAZ<span>.</span></div>
        </div>
      </section>

      <footer class="site-footer" id="socials">
        <div class="wrap footer__inner">
          <div class="footer__intro">
            <p class="eyebrow"><span class="eyebrow__dot"></span> SOCIAL</p>
            <h2>Follow along.</h2>
            <p>I share investing posts on X. I also want to write about technology, engineering, and green energy, and may make videos on those subjects.</p>
          </div>
          <div class="footer__links">
            <a href={xUrl} target="_blank" rel="me noreferrer">
              <span class="social-icon" aria-hidden="true">𝕏</span><span>X / TALHAEJAZ07EE</span><span aria-hidden="true">↗</span>
            </a>
            <a href={youtubeUrl} target="_blank" rel="me noreferrer">
              <span class="social-icon social-icon--play" aria-hidden="true">▶</span><span>YOUTUBE / TALHAEJAZ</span><span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="wrap footer__base">
          <a class="wordmark wordmark--footer" href="#top">
            <span class="wordmark__name">TALHA EJAZ</span>
            <span class="wordmark__sub">MARKETS &amp; IDEAS</span>
          </a>
          <span>© {currentYear} TALHA EJAZ</span>
          <a href="#top">BACK TO TOP ↑</a>
        </div>
      </footer>
    </main>
  </body>
</html>
